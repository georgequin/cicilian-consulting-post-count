# Postgres connection string. Vercel sets DATABASE_URL automatically when you
# connect a Neon database from the project's Storage tab.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Password that lets you log, edit and delete posts.
ADMIN_PASSWORD="choose-a-strong-password"

# Optional: password for view-only access (give this one to your boss).
# If you leave it empty, anyone with the link can view the log (but not edit).
VIEW_PASSWORD=""

# Long random string used to sign login cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=""

# Set automatically when you connect a Vercel Blob store (for screenshots).
BLOB_READ_WRITE_TOKEN=""
